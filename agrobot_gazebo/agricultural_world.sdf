    <!-- ========================= -->
    <!-- MARCADOR DE INÍCIO -->
    <!-- ========================= -->

    <model name="start_marker">
      <static>true</static>
      <pose>-9 0 0.04 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================= -->
    <!-- MARCADOR DE DESTINO -->
    <!-- ========================= -->

    <model name="goal_marker">
      <static>true</static>
      <pose>9 0 0.04 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
