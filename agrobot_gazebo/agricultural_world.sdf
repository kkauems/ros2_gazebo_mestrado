<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="agricultural_world">

    <!-- ========================= -->
    <!-- FÍSICA -->
    <!-- ========================= -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Necessário para sensores como LiDAR -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Necessário depois para IMU / inclinação -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>


    <!-- ========================= -->
    <!-- LUZ DO SOL -->
    <!-- ========================= -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.85 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>


    <!-- ========================= -->
    <!-- SOLO BASE -->
    <!-- ========================= -->

    <model name="soil_ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>28 22 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>28 22 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.48 0.30 0.14 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- CAMINHO CENTRAL AGRÍCOLA -->
    <!-- ========================= -->

    <model name="central_dirt_path">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>24 2.4 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.28 0.15 1</ambient>
            <diffuse>0.55 0.36 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================= -->
    <!-- SUBIDA PRINCIPAL -->
    <!-- Inclinação aproximada: 10 graus -->
    <!-- ========================= -->

    <model name="slope_up_10deg">
      <static>true</static>
      <pose>-6 0 0.28 0 0.17 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.5 2.6 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.5 2.6 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.24 0.11 1</ambient>
            <diffuse>0.52 0.34 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- PLATAFORMA ALTA -->
    <!-- ========================= -->

    <model name="upper_plateau">
      <static>true</static>
      <pose>-2.3 0 0.62 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 2.6 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 2.6 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.23 0.10 1</ambient>
            <diffuse>0.50 0.32 0.15 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- DESCIDA PARA O VALE -->
    <!-- Inclinação aproximada: -10 graus -->
    <!-- ========================= -->

    <model name="slope_down_10deg">
      <static>true</static>
      <pose>1.3 0 0.35 0 -0.17 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.5 2.6 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.5 2.6 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.24 0.11 1</ambient>
            <diffuse>0.52 0.34 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- VALE BAIXO -->
    <!-- Zona para testar estabilidade -->
    <!-- ========================= -->

    <model name="valley_low_area">
      <static>true</static>
      <pose>5.3 0 0.06 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 2.8 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 2.8 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.19 0.09 1</ambient>
            <diffuse>0.40 0.25 0.12 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- RAMPA MAIS DIFÍCIL -->
    <!-- Inclinação aproximada: 20 graus -->
    <!-- Para teste extremo -->
    <!-- ========================= -->

    <model name="test_slope_20deg">
      <static>true</static>
      <pose>0 -6 0.35 0 0.35 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.5 2.0 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.5 2.0 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.20 0.10 1</ambient>
            <diffuse>0.46 0.29 0.14 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- LINHAS DE CULTIVO -->
    <!-- Com colisão para servirem como limites -->
    <!-- ========================= -->

    <model name="crop_row_left_1">
      <static>true</static>
      <pose>0 2.7 0.32 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>24 0.35 0.60</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.35 0.60</size>
            </box>
          </geometry>
          <material>
            <ambient>0.04 0.30 0.04 1</ambient>
            <diffuse>0.05 0.55 0.05 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <model name="crop_row_right_1">
      <static>true</static>
      <pose>0 -2.7 0.32 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>24 0.35 0.60</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.35 0.60</size>
            </box>
          </geometry>
          <material>
            <ambient>0.04 0.30 0.04 1</ambient>
            <diffuse>0.05 0.55 0.05 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <model name="crop_row_left_2">
      <static>true</static>
      <pose>0 5.2 0.28 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.30 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.25 0.03 1</ambient>
            <diffuse>0.04 0.45 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="crop_row_right_2">
      <static>true</static>
      <pose>0 -5.2 0.28 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.30 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.25 0.03 1</ambient>
            <diffuse>0.04 0.45 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================= -->
    <!-- PEDRAS / OBSTÁCULOS -->
    <!-- ========================= -->

    <model name="stone_1">
      <static>true</static>
      <pose>-4.3 0.55 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.28</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.28</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.23 0.23 0.23 1</ambient>
            <diffuse>0.36 0.36 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="stone_2">
      <static>true</static>
      <pose>1.2 -0.45 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.23 0.23 0.23 1</ambient>
            <diffuse>0.36 0.36 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="stone_3">
      <static>true</static>
      <pose>5.6 0.65 0.28 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.30</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.30</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.32 0.32 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================= -->
    <!-- ÁRVORES -->
    <!-- ========================= -->

    <model name="tree_1">
      <static>true</static>
      <pose>-8 6 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.12 0.04 1</ambient>
            <diffuse>0.35 0.18 0.06 1</diffuse>
          </material>
        </visual>

        <visual name="leaves_visual">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.55</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.02 0.22 0.02 1</ambient>
            <diffuse>0.04 0.40 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="tree_2">
      <static>true</static>
      <pose>7 5.5 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.12 0.04 1</ambient>
            <diffuse>0.35 0.18 0.06 1</diffuse>
          </material>
        </visual>

        <visual name="leaves_visual">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.55</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.02 0.22 0.02 1</ambient>
            <diffuse>0.04 0.40 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="tree_3">
      <static>true</static>
      <pose>-7 -6 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.12 0.04 1</ambient>
            <diffuse>0.35 0.18 0.06 1</diffuse>
          </material>
        </visual>

        <visual name="leaves_visual">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.55</radius>
            </sphere>
          </geometry>
