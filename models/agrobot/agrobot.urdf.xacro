<?xml version="1.0"?>
<robot name="agrobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="1.10 0.75 0.18"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="1.10 0.75 0.18"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="34"/>
      <inertia ixx="1.9" ixy="0" ixz="0" iyy="3.8" iyz="0" izz="4.8"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.165" length="0.10"/>
        </geometry>
        <material name="black">
          <color rgba="0.02 0.02 0.02 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.165" length="0.10"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="3"/>
        <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.165" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel"  x="0.38"  y="0.43"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.38" y="0.43"/>
  <xacro:wheel name="front_right_wheel" x="0.38"  y="-0.43"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.38" y="-0.43"/>

</robot>